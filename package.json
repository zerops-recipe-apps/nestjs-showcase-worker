{
  "name": "nestjs-showcase-worker",
  "version": "1.0.0",
  "description": "NestJS NATS worker for the nestjs-showcase recipe on Zerops",
  "author": "Zerops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerops-recipe-apps/nestjs-showcase-worker"
  },
  "homepage": "https://github.com/zerops-recipe-apps/nestjs-showcase-worker",
  "bugs": {
    "url": "https://github.com/zerops-recipe-apps/nestjs-showcase-worker/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "ts-node src/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "ioredis": "5.9.3",
    "meilisearch": "0.60.0",
    "nats": "2.29.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@types/node": "26.1.1",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "keywords": [
    "nestjs",
    "zerops",
    "worker",
    "nats",
    "postgresql"
  ],
  "overrides": {
    "brace-expansion": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "uuid": "11.1.1",
    "qs": "6.15.2",
    "@babel/core": "7.29.7",
    "body-parser": "2.3.0",
    "browserslist": "4.28.8"
  }
}
